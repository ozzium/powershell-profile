{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Registry",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}\\Public\\Show-PowerTreeRegistry.ps1",
      "args": ["-Path", "HKLM:\\SOFTWARE"]
    },
    {
      "name": "PowerShell: Run PowerTree Test",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/Test.ps1",
      "args": [
        "-DisplaySize",
        "-SortBySize",
        "-Path",
        "${workspaceFolder}",
        "-OutFile",
        "x",
        "-verbose",
        "-Quiet",
        "-DisplayMode",
        "-DisplayModificationDate"
      ]
    }
  ]
}
